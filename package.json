{
  "name": "argonvault",
  "version": "1.0.0",
  "description": "Password file and note locker: Argon2id + AES-256-GCM, entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:standalone": "vite build --mode standalone",
    "build:artifact": "vite build --mode artifact",
    "preview": "vite preview --port 4173 --strictPort",
    "compile:contract": "node scripts/compile-contract.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@noble/hashes": "2.4.0",
    "@zxcvbn-ts/core": "4.3.0",
    "@zxcvbn-ts/language-common": "4.2.0",
    "@zxcvbn-ts/language-en": "4.1.2",
    "fflate": "0.8.3",
    "gsap": "3.15.1",
    "hash-wasm": "4.13.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vgpu": "0.3.1"
  },
  "devDependencies": {
    "@ethereumjs/block": "10.1.3",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/tx": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.10",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "ethers": "6.17.0",
    "oxlint": "1.95.0",
    "prettier": "3.10.1",
    "solc": "0.8.39",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.2"
  },
  "private": true,
  "type": "module",
  "overrides": {
    "@modelcontextprotocol/server": "2.4.0",
    "tmp": "0.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
